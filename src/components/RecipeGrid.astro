---
import Img from './Img.astro';
import { CATEGORIES } from '../site.config';
const { recipes } = Astro.props;
---
<div class="grid" data-grid>
  {recipes.map((r: any) => (
    <a class="card" href={`/${r.id}/`} data-cat={r.data.category} data-mins={r.data.prepMinutes + r.data.cookMinutes}
       data-text={`${r.data.title} ${r.data.keywords.join(' ')} ${r.data.ingredients.join(' ')}`.toLowerCase()}>
      <div class="media">
        <Img src={r.data.image.src} alt={r.data.image.alt} label={r.data.title} />
        <span class="time">{r.data.prepMinutes + r.data.cookMinutes} min</span>
      </div>
      <h2>{r.data.title}</h2>
      <div class="meta">{CATEGORIES[r.data.category as keyof typeof CATEGORIES].name} · serves {r.data.servings}</div>
    </a>
  ))}
</div>
<p class="empty" data-empty hidden>No recipes match. Try another word.</p>
