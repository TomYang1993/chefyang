---
import Img from './Img.astro';
import { CATEGORIES } from '../site.config';
const { recipes } = Astro.props;
---
<div class="grid" data-grid>
  {recipes.map((r: any) => (
    <a class="card" href={`/${r.id}/`} data-cat={r.data.category} data-mins={r.data.prepMinutes + r.data.cookMinutes}
       data-text={`${r.data.title} ${r.data.keywords.join(' ')} ${r.data.ingredients.join(' ')}`.toLowerCase()}>
      <div class="media">
        <Img src={r.data.image.src} alt={r.data.image.alt} label={r.data.title} />
      </div>
      <h2>{r.data.title}</h2>
      <p class="meta">{r.data.prepMinutes + r.data.cookMinutes} minutes, serves {r.data.servings}. {CATEGORIES[r.data.category as keyof typeof CATEGORIES].name}.</p>
    </a>
  ))}
</div>
<p class="empty" data-empty hidden>Nothing matches that yet. Try another ingredient, or clear the time filter.</p>
