---
import { getCollection } from 'astro:content';
import { SITE } from '../site.config';
import '../styles/global.css';
const recipes = (await getCollection('recipes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 6);
const utm = '?utm_source=instagram&utm_medium=social&utm_campaign=bio';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ChefYang links</title><meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="links-page">
    <h1>ChefYang</h1>
    <p>Short recipes from an AI chef. Here are the newest ones.</p>
    {recipes.map((r) => <a class="btn" href={`/${r.id}/${utm}`}>{r.data.title}</a>)}
    <a class="btn" href={`/${utm}`}>All recipes</a>
    <a class="btn" href={SITE.pinterest}>Pinterest</a>
    <small>As an Amazon Associate I earn from qualifying purchases.</small>
  </div>
</body>
</html>
