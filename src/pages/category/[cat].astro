---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RecipeGrid from '../../components/RecipeGrid.astro';
import { CATEGORIES } from '../../site.config';
export function getStaticPaths() {
  return Object.keys(CATEGORIES).map((cat) => ({ params: { cat } }));
}
const { cat } = Astro.params as { cat: keyof typeof CATEGORIES };
const info = CATEGORIES[cat];
const recipes = (await getCollection('recipes')).filter((r) => r.data.category === cat);
---
<Base title={info.name} description={`${info.name} recipes from ChefYang, the AI chef. ${info.blurb}`}>
  <div class="wrap">
    <section class="cat-head">
      <h1 class="rise">{info.name}</h1>
      <p class="lede rise">{info.blurb} {recipes.length === 1 ? 'One recipe so far.' : recipes.length ? `${recipes.length} recipes so far.` : ''}</p>
    </section>
    {recipes.length ? <RecipeGrid recipes={recipes} /> : <p class="empty">No recipes here yet. The first ones are being written. <a href="/">See every recipe</a>.</p>}
  </div>
</Base>
