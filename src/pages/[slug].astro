---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import RecipeGrid from '../components/RecipeGrid.astro';
import { SITE, CATEGORIES, amazonLink, parseIngredient } from '../site.config';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((r) => ({ params: { slug: r.id }, props: { recipe: r } }));
}
const { recipe } = Astro.props;
const d = recipe.data;
const { Content } = await render(recipe);
const url = new URL(`/${recipe.id}/`, SITE.url).href;
const imgUrl = new URL(d.image.src, SITE.url).href;
const iso = (m: number) => `PT${m}M`;
const cat = CATEGORIES[d.category];
const total = d.prepMinutes + d.cookMinutes;

const ingredients = d.ingredients.map(parseIngredient);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: d.title,
  description: d.description,
  image: [imgUrl],
  author: { '@type': 'Organization', name: 'ChefYang (AI)', url: SITE.url },
  datePublished: d.date.toISOString().slice(0, 10),
  prepTime: iso(d.prepMinutes),
  cookTime: iso(d.cookMinutes),
  totalTime: iso(total),
  recipeYield: `${d.servings} servings`,
  recipeCategory: cat.name,
  recipeCuisine: d.cuisine,
  keywords: d.keywords.join(', '),
  nutrition: { '@type': 'NutritionInformation', calories: `${d.calories} calories` },
  recipeIngredient: d.ingredients,
  recipeInstructions: d.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, text: s, url: `${url}#step-${i + 1}` })),
};
const pinHref = `https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&media=${encodeURIComponent(imgUrl)}&description=${encodeURIComponent(d.pins[0]?.title ?? d.title)}`;
const all = (await getCollection('recipes')).filter((r) => r.id !== recipe.id);
const related = [...all.filter((r) => r.data.category === d.category), ...all.filter((r) => r.data.category !== d.category)].slice(0, 3);
---
<Base title={d.title} description={d.description} image={d.image.src} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <div class="wrap">
    <header class="post-head">
      <div>
        <h1 class="rise">{d.title}</h1>
        <p class="lede rise">{d.description}</p>
        <p class="where rise"><a href={`/category/${d.category}/`}>{cat.name}</a>, {d.cuisine} cooking.</p>
        <dl class="facts rise">
          <div><dt>Prep</dt><dd>{d.prepMinutes} min</dd></div>
          <div><dt>Cook</dt><dd>{d.cookMinutes} min</dd></div>
          <div><dt>Total</dt><dd>{total} min</dd></div>
          <div><dt>Serves</dt><dd>{d.servings}</dd></div>
        </dl>
        <div class="actions">
          <a class="btn primary" href="#recipe">Jump to the recipe</a>
          <button class="btn" type="button" aria-pressed="false" data-cook>Cook mode</button>
          <button class="btn" type="button" data-print>Print</button>
          <a class="btn" href={pinHref} target="_blank" rel="noopener">Save to Pinterest</a>
        </div>
        <p class="note">Recipe and photo made with AI. Amazon links below are affiliate links: as an Amazon Associate I earn from qualifying purchases.</p>
      </div>
      <div class="post-media">
        <Img src={d.image.src} alt={d.image.alt} label={d.title} eager />
      </div>
    </header>

    <section class="recipe" id="recipe">
      <aside>
        <div class="panel">
          <div class="panel-head">
            <h2>Ingredients</h2>
            <div class="stepper" data-base={d.servings}>
              <button type="button" aria-label="Fewer servings" data-step="-1">−</button>
              <output aria-live="polite" data-servings>{d.servings} servings</output>
              <button type="button" aria-label="More servings" data-step="1">+</button>
            </div>
          </div>
          <ul class="checklist">
            {ingredients.map((ing) => (
              <li><label><input type="checkbox" /><span>{ing.qty !== null && <b data-qty={ing.qty}>{ing.shown}</b>}{ing.rest}</span></label></li>
            ))}
          </ul>
          <div class="gear">
            <h3>What you'll need</h3>
            {d.gear.map((g) => (
              <a href={amazonLink(g.search)} rel="sponsored nofollow noopener" target="_blank">
                <strong>{g.name}</strong><small>{g.why}</small><span class="go">On Amazon</span>
              </a>
            ))}
          </div>
        </div>
      </aside>
      <div>
        <div class="method-head">
          <h2>Method</h2>
          <p>Tap a step when it's done.</p>
        </div>
        <ol class="steps">
          {d.steps.map((s, i) => <li id={`step-${i + 1}`}>{s}</li>)}
        </ol>
        {d.notes.length > 0 && <div class="tips"><h3>Good to know</h3><ul>{d.notes.map((n) => <li>{n}</li>)}</ul></div>}
        <div class="prose"><Content /></div>
        <p class="note">About {d.calories} calories per serving (AI estimate). Written by AI and checked by a second AI pass; use normal kitchen care.</p>
      </div>
    </section>

    {related.length > 0 && <>
      <h2 class="section-title">Cook this next</h2>
      <RecipeGrid recipes={related} />
    </>}
  </div>
  <script>
    // Servings scaler
    const stepper = document.querySelector<HTMLElement>('[data-base]')!;
    const base = Number(stepper.dataset.base);
    let n = base;
    const out = document.querySelector<HTMLOutputElement>('[data-servings]')!;
    const fmt = (x: number) => {
      const whole = Math.floor(x), frac = x - whole;
      const fracs: [number, string][] = [[0, ''], [0.25, '¼'], [1 / 3, '⅓'], [0.5, '½'], [2 / 3, '⅔'], [0.75, '¾'], [1, '']];
      const [v, s] = fracs.reduce((a, b) => (Math.abs(b[0] - frac) < Math.abs(a[0] - frac) ? b : a));
      const w = v === 1 ? whole + 1 : whole;
      return (w ? String(w) : '') + s || '0';
    };
    stepper.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => {
      n = Math.max(1, n + Number(b.dataset.step));
      out.textContent = `${n} serving${n === 1 ? '' : 's'}`;
      document.querySelectorAll<HTMLElement>('[data-qty]').forEach((el) => { el.textContent = fmt((Number(el.dataset.qty) * n) / base); });
    }));
    // Tap steps to mark done
    document.querySelectorAll('.steps li').forEach((li) => li.addEventListener('click', () => li.classList.toggle('done')));
    // Cook mode keeps the screen on and enlarges text
    let lock: any = null;
    const cook = document.querySelector<HTMLButtonElement>('[data-cook]')!;
    cook.addEventListener('click', async () => {
      const on = cook.getAttribute('aria-pressed') !== 'true';
      cook.setAttribute('aria-pressed', String(on));
      document.body.classList.toggle('cook', on);
      try { if (on && 'wakeLock' in navigator) lock = await (navigator as any).wakeLock.request('screen'); else { await lock?.release(); lock = null; } } catch {}
      if (on) document.getElementById('recipe')?.scrollIntoView({ behavior: 'smooth' });
    });
    document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  </script>
</Base>
