---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import RecipeGrid from '../components/RecipeGrid.astro';
import RecipeMagazine from '../components/RecipeMagazine.astro';
import { toShowcase } from '../utils/showcase';
import { SITE } from '../site.config';
const recipes = (await getCollection('recipes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={SITE.name} description={SITE.description}>
  <div class="wrap">
    <section class="covers-head">
      <h1 class="rise">This week's covers</h1>
      <p class="lede rise">Short recipes from an AI chef. Drag through the covers, or scroll the whole roll below.</p>
    </section>
  </div>
  <RecipeMagazine items={toShowcase(recipes)} label="This week's recipes" />
  <div class="wrap">
    <section class="index" aria-labelledby="all-recipes">
      <div class="index-head">
        <h2 id="all-recipes">All recipes</h2>
        <div class="toolbar">
          <label class="search"><span class="sr">Search recipes</span><input type="search" placeholder="Search chicken, noodles, rice" data-search /></label>
          <div class="filters" role="group" aria-label="Filter by time">
            <button class="filter" aria-pressed="true" data-max="0">Any time</button>
            <button class="filter" aria-pressed="false" data-max="20">Under 20 min</button>
            <button class="filter" aria-pressed="false" data-max="30">Under 30 min</button>
          </div>
        </div>
      </div>
      <RecipeGrid recipes={recipes} />
    </section>
  </div>
  <script>
    const q = document.querySelector<HTMLInputElement>('[data-search]')!;
    const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-max]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-grid] .card')];
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    let max = 0;
    function apply() {
      const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const c of cards) {
        const ok = (!max || Number(c.dataset.mins) <= max) && words.every((w) => c.dataset.text!.includes(w));
        c.hidden = !ok; if (ok) shown++;
      }
      for (const d of document.querySelectorAll<HTMLElement>('[data-day]')) d.hidden = !d.querySelector('.card:not([hidden])');
      empty.hidden = shown > 0;
    }
    q.addEventListener('input', apply);
    chips.forEach((b) => b.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      max = Number(b.dataset.max); apply();
    }));
  </script>
</Base>
