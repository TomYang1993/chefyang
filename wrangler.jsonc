// Cloudflare Workers Builds config: serve the static Astro build from ./dist as Worker static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chefyang",
  "compatibility_date": "2026-11-01",
  // Build inside wrangler too, so deploys work even if the dashboard build command is empty.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist"
  }
}
